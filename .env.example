# Database Configuration
DATABASE_URL="postgresql://stock_user:stock_password@localhost:5432/stock_intervention_db?schema=public"
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password
POSTGRES_DB=stock_intervention_db

# API Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Admin par défaut
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Configuration Nom de domaine & HTTPS (Caddy / DuckDNS)
DOMAIN=your-subdomain.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token-here

# Optionnel: Réinitialisation forcée de l'admin au démarrage
SEED_ON_START=false

# Notifications Push Web (VAPID)
VAPID_PUBLIC_KEY="votre_cle_publique_vapid"
VAPID_PRIVATE_KEY="votre_cle_privee_vapid"
VAPID_SUBJECT="mailto:votre-email-contact@domaine.fr"

# Synchronisation Calendrier Partagé Microsoft Outlook (Graph API)
OUTLOOK_TENANT_ID="votre_tenant_id_azure"
OUTLOOK_CLIENT_ID="votre_client_id_azure"
OUTLOOK_CLIENT_SECRET="votre_client_secret_azure"
OUTLOOK_SHARED_CALENDAR_EMAIL="agenda-partage@votre-domaine.fr"

# Configuration Synchronisation Liens IP & Commandes UNYC / Atlas
UNYC_BASE_URL="https://atlas-public-api.web.production.unyc.io"
UNYC_IAM_URL="https://accounts.unyc.io/realms/production"
UNYC_CLIENT_ID="public-api"
UNYC_USERNAME="votre_login_unyc"
UNYC_PASSWORD="votre_mot_de_passe_unyc"
ATLAS_IP_LINKS_URL="https://atlas.unyc.io/lien"
ATLAS_USERNAME="votre_login_atlas"
ATLAS_PASSWORD="votre_mot_de_passe_atlas"
ATLAS_TOTP_URI="otpauth://totp/..."
